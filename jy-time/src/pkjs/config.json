          {
            "label": "Alt timezone",
            "value": "alt_timezone"
          },
          {
            "label": "Heart rate big",
            "value": "heart_rate"
          },
          {
            "label": "Stocks & Crypto Prices",
            "value": "prices"
          },
          {
            "label": "Tide chart",
            "value": "tide_chart"
          },
          {
            "label": "Step history",
            "value": "step_history"
          },
          {
            "label": "NWS Forecast",
            "value": "nws_forecast"
          }
        ],
        "description": "Each overlay's color follows the Light mode toggle in the Theme section above. Fitness rings has its own three ring colors; every other overlay uses Light/Dark only."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_OVERLAY_DURATION_S",
        "label": "Shake overlay duration",
        "defaultValue": "5",
        "options": [
          {
            "label": "3 seconds",
            "value": "3"
          },
          {
            "label": "5 seconds (default)",
            "value": "5"
          },
          {
            "label": "7 seconds",
            "value": "7"
          },
          {
            "label": "10 seconds",
            "value": "10"
          }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "id": "shake-fitness-heading",
        "defaultValue": "Fitness rings settings"
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_RING_STEPS_ON",
        "label": "Show steps ring",
        "defaultValue": true
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_RING_ACTIVE_ON",
