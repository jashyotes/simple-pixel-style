  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Time"
      },
      {
        "type": "select",
        "messageKey": "TIME_FONT",
        "label": "Time font",
        "defaultValue": "1",
        "options": [
          {
            "label": "Default",
            "value": "0"
          },
          {
            "label": "CASIO style",
            "value": "1"
          },
          {
            "label": "Roboto",
            "value": "2"
          },
          {
            "label": "LECO",
            "value": "3"
          }
        ],
        "description": "Default is the original Bitham bold serif. CASIO style renders the time as WV-58A LCD digits with an optional shadow/backdrop treatment. Roboto is Pebble's built-in Roboto bold subset. LECO is Pebble's built-in LECO 32 bold numbers. Roboto and LECO anchor AM/PM bottom to the digit bottom. LECO is not available on round watches; it falls back to Default there."
      },
      {
        "type": "toggle",
        "messageKey": "CASIO_PHANTOM",
        "label": "CASIO shadow/backdrop effect",
        "defaultValue": true,
        "description": "Enables the CASIO shadow treatment. Light time sections keep the classic faded 88:88 all-segments-lit backdrop; dark time sections use the shadow style selected below. Turn off for a clean foreground-only look. Only applies when Time font is CASIO style."
      },
      {
        "type": "select",
        "messageKey": "CASIO_DARK_SHADOW_STYLE",
        "label": "Dark CASIO shadow style",
        "defaultValue": "offset",
        "options": [
          {
            "label": "Hollow 88:88 + Offset Shadow",
            "value": "halo_shadow"
          },
          {
            "label": "Stippled 88:88 + Offset Shadow",
            "value": "stipple"
          },
          {
            "label": "True Offset Shadow Only (default)",
            "value": "offset"
          },
          {
            "label": "Hollow gray 88:88",
            "value": "halo"
          }
        ],
        "description": "Hollow + Offset Shadow draws the sparse neutral-gray outline of the 88:88 LCD backdrop plus the current time's own shadow 2 px down and right. Stippled keeps the full 88:88 backdrop faintly visible as outlined ghost segments with a sparse even dot fill, plus the same shadow. True Offset Shadow Only draws just the time's shadow with no 88:88 backdrop. Hollow gray 88:88 draws just the outline backdrop with no shadow. Applies only to dark CASIO time sections when the effect above is on."
      },
      {
        "type": "toggle",
        "messageKey": "MILITARY_TIME",
        "label": "Use military time",
        "defaultValue": false,
        "description": "Shows the main time in 24-hour format and hides AM/PM."
      },
      {
        "type": "toggle",
        "messageKey": "REMOVE_LEADING_ZERO",
        "label": "Remove leading zero",
        "defaultValue": false,
        "description": "Shows 9:05 instead of 09:05 on the main time."
      },
      {
        "type": "select",
        "messageKey": "DATE_LANGUAGE",
        "label": "Date language",
        "defaultValue": "en",
        "options": [
          {
            "label": "English",
            "value": "en"
          },
          {
            "label": "日本語 (6月2日 火曜日)",
            "value": "ja"
          },
          {
            "label": "日本語 compact (6月2日（火）)",
            "value": "ja_compact"
          },
          {
            "label": "Français (mardi 2 juin)",
            "value": "fr"
          }
        ],
        "description": "Language for the date line only. Japanese shows the date as 6月2日 火曜日 (full) or 6月2日（火） (compact); French shows it as mardi 2 juin. Everything else is unchanged."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "id": "multi-tz-heading",
        "defaultValue": "Multi-timezone"
      },
      {
        "type": "toggle",
        "messageKey": "MULTI_TZ_ENABLED",
        "label": "Show timezones under the clock",
        "defaultValue": false,
        "description": "Off by default. When off the watchface is unchanged. When on, up to two secondary timezones appear beneath the main time, and verbose weather collapses to one line to make room. The label and daylight saving offset are derived automatically from the zone you pick, so they stay correct year round."
      },
