      },
      {
        "type": "input",
        "messageKey": "WEATHER_LAT",
        "label": "Manual latitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "30.246"
        }
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LON",
        "label": "Manual longitude",
        "defaultValue": "",
        "attributes": {
