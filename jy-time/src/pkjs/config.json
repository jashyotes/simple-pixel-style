[
  {
    "type": "heading",
    "defaultValue": "Simple Pixel Style"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Theme"
      },
      {
        "type": "toggle",
        "messageKey": "LIGHT_MODE",
        "label": "Light mode",
        "defaultValue": false,
        "description": "Light = white background with black text. Dark = black background with white text. This setting drives the Black & White theme and every shake overlay."
      },
      {
        "type": "select",
        "messageKey": "COLOR_MODE",
        "id": "color-mode-select",
        "label": "Color mode",
        "defaultValue": "bw",
        "options": [
          {
            "label": "Black & White - Tuxedo",
            "value": "bw"
          },
          {
            "label": "Color - Poor & Irish",
            "value": "color"
          }
        ],
        "description": "Black & White uses the inversion toggles below. Color uses the per-section pickers below. Shake overlays always follow the Light mode toggle above."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "id": "bw-heading",
        "defaultValue": "Black & White inversions"
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_TOP_BAR",
        "label": "Invert top bar",
        "defaultValue": false,
        "description": "Swaps the battery, step, and Bluetooth bar colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_DATE_BAR",
        "label": "Invert date bar",
        "defaultValue": false,
        "description": "Swaps the date bar colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_TIME",
        "label": "Invert time",
        "defaultValue": false,
        "description": "Swaps the time row colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_WEATHER",
        "label": "Invert weather",
        "defaultValue": false,
        "description": "Swaps the complication or verbose weather colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_MEETING_BAR",
        "label": "Invert meeting bar",
        "defaultValue": false,
        "description": "Swaps the meeting bar colors."
      }
    ]
  },
