  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Weather"
      },
      {
        "type": "toggle",
        "messageKey": "WEATHER_ENABLED",
        "label": "Enable weather",
        "defaultValue": true,
        "description": "Fetches Open-Meteo weather from the phone and updates the weather/rain circles."
      },
      {
        "type": "select",
        "messageKey": "WEATHER_SOURCE",
        "label": "Location",
        "defaultValue": "gps",
        "options": [
          {
            "label": "Current phone location",
            "value": "gps"
          },
          {
            "label": "Manual coordinates",
            "value": "manual"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LAT",
        "label": "Manual latitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "30.246"
        }
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LON",
        "label": "Manual longitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "-87.700"
        }
      },
      {
        "type": "select",
        "messageKey": "TEMPERATURE_UNIT",
        "label": "Temperature unit",
        "defaultValue": "fahrenheit",
        "options": [
          {
            "label": "Fahrenheit",
            "value": "fahrenheit"
          },
          {
            "label": "Celsius",
            "value": "celsius"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "WEATHER_REFRESH_MIN",
        "label": "Refresh",
        "defaultValue": "30",
        "options": [
          {
            "label": "Every 15 minutes",
            "value": "15"
          },
          {
            "label": "Every 30 minutes",
            "value": "30"
          },
          {
            "label": "Every hour",
            "value": "60"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "WEATHER_PROVIDER",
        "label": "NWS Forecast provider",
        "defaultValue": "open_meteo",
        "description": "When set to NWS, the NWS Forecast shake overlay pulls hourly + narrative data from api.weather.gov. NWS only covers the United States. The main face and Detailed Weather overlay always use Open-Meteo.",
        "options": [
          {
            "label": "Open-Meteo only (global, default)",
            "value": "open_meteo"
          },
          {
            "label": "NWS (api.weather.gov, US only)",
            "value": "nws"
          }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Calendar"
      },
      {
        "type": "toggle",
        "messageKey": "CALENDAR_ENABLED",
        "label": "Enable bottom event",
        "defaultValue": false,
        "description": "Uses a private iCal/ICS feed URL. PebbleKit JS cannot read the phone calendar directly."
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL",
        "label": "Calendar .ics URL",
        "defaultValue": "",
        "attributes": {
          "type": "url",
          "placeholder": "https://calendar.google.com/..."
        }
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL_2",
        "label": "Second calendar .ics URL",
        "defaultValue": "",
        "attributes": {
          "type": "url",
          "placeholder": "https://calendar.google.com/..."
        }
      },
      {
        "type": "select",
        "messageKey": "CALENDAR_LOOKAHEAD_HOURS",
        "label": "Look ahead",
        "defaultValue": "48",
        "options": [
          {
            "label": "24 hours",
            "value": "24"
          },
          {
            "label": "48 hours",
            "value": "48"
          },
          {
            "label": "7 days",
            "value": "168"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "EMPTY_EVENT_LABEL",
        "label": "No-events label",
        "defaultValue": "[None]",
        "attributes": {
          "type": "text",
          "maxLength": 24,
          "placeholder": "[None]"
        },
        "description": "Shown on the meeting bar, the Your Day 'Next:' line, and the Upcoming shake overlay when there's nothing scheduled."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Shake"
      },
      {
        "type": "select",
        "messageKey": "SHAKE_BEHAVIOR",
        "id": "shake-behavior-select",
        "label": "Shake behavior",
        "defaultValue": "off",
        "options": [
          {
            "label": "Off",
            "value": "off"
          },
          {
            "label": "Fitness rings",
            "value": "fitness_rings"
          },
          {
            "label": "Next calendar events",
            "value": "calendar_events"
          },
          {
            "label": "Your Day",
            "value": "your_day"
