  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Layout"
      },
      {
        "type": "select",
        "messageKey": "TIME_FONT",
        "label": "Time font",
        "defaultValue": "0",
        "options": [
          {
            "label": "Default",
            "value": "0"
          },
          {
            "label": "CASIO style",
            "value": "1"
          },
          {
            "label": "Roboto",
            "value": "2"
          },
          {
            "label": "LECO",
            "value": "3"
          }
        ],
        "description": "Default is the original Bitham bold serif. CASIO style renders the time as WV-58A LCD digits with a phantom 88:88 backdrop. Roboto is Pebble's built-in Roboto bold subset. LECO is Pebble's built-in LECO 32 bold numbers. Roboto and LECO anchor AM/PM bottom to the digit bottom."
      },
      {
        "type": "toggle",
        "messageKey": "CASIO_PHANTOM",
        "label": "CASIO phantom 88:88 backdrop",
        "defaultValue": true,
        "description": "Draws the faded 88:88 all-segments-lit backdrop behind the CASIO digits. Turn off for a clean foreground-only look. Only applies when Time font is CASIO style."
      },
      {
        "type": "toggle",
        "messageKey": "TOP_STEPS",
        "label": "Top W800 step counter",
        "defaultValue": true,
        "description": "Shows the walking-man step counter above the date."
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_PIP_ROW_ON",
        "label": "FuelBand-style pip row",
        "defaultValue": false,
        "description": "Horizontal 20-pip step-progress strip below the top bar. Pips fill in halves; each completed goal swaps pip shape (rectangles, then triangles, then squares). Off by default."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_SHAPE",
        "label": "Pip shape",
        "defaultValue": "circle",
        "options": [
          { "label": "Circle (Your Day style)", "value": "circle" },
          { "label": "Rectangle",               "value": "rectangle" }
        ],
        "description": "Shape used for pips below your step goal. After hitting your goal once, pips become triangles; after hitting it twice, squares."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_SIZE",
        "label": "Pip size",
        "defaultValue": "large",
        "options": [
          { "label": "Large (default)", "value": "large" },
          { "label": "Small",            "value": "small" }
        ],
        "description": "Large pips fill the full 9px gap between the step counter and the date. Small pips are the original 5px version, centered in the same gap."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_DIRECTION",
        "label": "Pip fill direction",
        "defaultValue": "ltr",
        "options": [
          { "label": "Left to right", "value": "ltr" },
          { "label": "Center out",    "value": "center" },
          { "label": "Right to left", "value": "rtl" }
        ]
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_STYLE",
        "label": "Pip style",
        "defaultValue": "hollow",
        "options": [
          { "label": "Hollow track (active pip fills)", "value": "hollow" },
          { "label": "Populate as you walk",            "value": "populate" }
        ]
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_COLOR_SOURCE",
        "label": "Pip color source",
        "defaultValue": "theme",
        "options": [
          { "label": "Match watch theme (B&W in Tuxedo)", "value": "theme" },
          { "label": "Always color (use pickers below)",  "value": "color" }
        ],
        "description": "When set to 'Match watch theme', pips render in B&W under Tuxedo and use the color pickers under Poor & Irish. Set to 'Always color' to keep colored pips even with the global Tuxedo theme."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_COLOR_DIST",
        "label": "Pip color distribution",
        "defaultValue": "asymptotic",
        "options": [
          { "label": "Asymptotic FuelBand (10 / 6 / 4)", "value": "asymptotic" },
          { "label": "Linear gradient",                  "value": "linear" }
        ],
        "description": "Asymptotic FuelBand: the first 10 pips show the low color, the middle 6 show the mid color, only the last 4 show the high color (loaded toward red so the green payoff feels earned). Linear smoothly interpolates across all 20 pips. Past your goal (lap 1+) every pip locks to the high color regardless of this setting."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_LOW",
        "label": "Pip color (low end)",
        "defaultValue": 16711680,
        "sunlight": false,
        "description": "Color of the leftmost pip. Defaults to red (FuelBand red)."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_MID",
        "label": "Pip color (middle)",
        "defaultValue": 16776960,
        "sunlight": false,
        "description": "Color at the midpoint pip. Pebble's 64-color palette can't reach pure yellow on a straight red->green interpolation, so the explicit midpoint keeps the rainbow visible. Defaults to yellow."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_HIGH",
        "label": "Pip color (high end)",
        "defaultValue": 65280,
        "sunlight": false,
        "description": "Color of the rightmost pip and the color every pip locks to after you pass your step goal. Defaults to green (FuelBand green)."
      },
      {
        "type": "toggle",
        "messageKey": "VIBRATE_ON_DISCONNECT",
        "label": "Vibrate on disconnect",
        "defaultValue": false,
        "description": "Buzzes the watch when the phone app connection drops."
      },
      {
        "type": "toggle",
        "messageKey": "MILITARY_TIME",
        "label": "Use military time",
        "defaultValue": false,
        "description": "Shows the main time in 24-hour format and hides AM/PM."
      },
      {
        "type": "toggle",
        "messageKey": "REMOVE_LEADING_ZERO",
        "label": "Remove leading zero",
        "defaultValue": false,
        "description": "Shows 9:05 instead of 09:05 on the main time."
      },
      {
        "type": "toggle",
        "messageKey": "VERBOSE_WEATHER",
        "label": "Verbose weather, centered time",
        "defaultValue": false,
        "description": "Replaces the complication circles with one centered weather line."
      },
      {
        "type": "select",
        "messageKey": "VERBOSE_WEATHER_STYLE",
        "label": "Verbose weather style",
        "defaultValue": "one_line",
        "options": [
          {
