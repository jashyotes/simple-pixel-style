  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Fitness pip row"
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_PIP_ROW_ON",
        "label": "FuelBand-style pip row",
        "defaultValue": true,
        "description": "Horizontal 20-pip step-progress strip below the top bar. Pips fill in halves; each completed goal swaps pip shape (rectangles, then triangles, then squares). Off by default."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_SHAPE",
        "label": "Pip shape",
        "defaultValue": "circle",
        "options": [
          { "label": "Circle (Your Day style)", "value": "circle" },
          { "label": "Rectangle",               "value": "rectangle" }
        ],
        "description": "Shape used for pips below your step goal. After hitting your goal once, pips become triangles; after hitting it twice, squares."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_SIZE",
        "label": "Pip size",
        "defaultValue": "large",
        "options": [
          { "label": "Large (default)", "value": "large" },
          { "label": "Small",            "value": "small" }
        ],
        "description": "Large pips fill the full 9px gap between the step counter and the date. Small pips are the original 5px version, centered in the same gap."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_DIRECTION",
        "label": "Pip fill direction",
        "defaultValue": "ltr",
        "options": [
          { "label": "Left to right", "value": "ltr" },
          { "label": "Center out",    "value": "center" },
          { "label": "Right to left", "value": "rtl" }
        ]
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_STYLE",
        "label": "Pip style",
        "defaultValue": "hollow",
        "options": [
          { "label": "Hollow track (active pip fills)", "value": "hollow" },
          { "label": "Populate as you walk",            "value": "populate" }
        ]
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_COLOR_SOURCE",
        "label": "Pip color source",
        "defaultValue": "color",
        "options": [
          { "label": "Match watch theme (B&W in Tuxedo)", "value": "theme" },
          { "label": "Always color (use pickers below)",  "value": "color" }
        ],
        "description": "When set to 'Match watch theme', pips render in B&W under Tuxedo and use the color pickers under Poor & Irish. Set to 'Always color' to keep colored pips even with the global Tuxedo theme."
      },
      {
        "type": "select",
        "messageKey": "FITNESS_PIP_COLOR_DIST",
        "label": "Pip color distribution",
        "defaultValue": "asymptotic",
        "options": [
          { "label": "Asymptotic FuelBand (10 / 6 / 4)", "value": "asymptotic" },
          { "label": "Linear gradient",                  "value": "linear" }
        ],
        "description": "Asymptotic FuelBand: the first 10 pips show the low color, the middle 6 show the mid color, only the last 4 show the high color (loaded toward red so the green payoff feels earned). Linear smoothly interpolates across all 20 pips. Past your goal (lap 1+) every pip locks to the high color regardless of this setting."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_LOW",
        "label": "Pip color (low end)",
        "defaultValue": 16711680,
        "sunlight": false,
        "description": "Color of the leftmost pip. Defaults to red (FuelBand red)."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_MID",
        "label": "Pip color (middle)",
        "defaultValue": 16755200,
        "sunlight": false,
        "description": "Color at the midpoint pip. Pebble's 64-color palette can't reach pure yellow on a straight red->green interpolation, so the explicit midpoint keeps the rainbow visible. Defaults to a mustardy orange."
      },
      {
        "type": "color",
        "messageKey": "FITNESS_PIP_COLOR_HIGH",
        "label": "Pip color (high end)",
        "defaultValue": 21760,
        "sunlight": false,
        "description": "Color of the rightmost pip and the color every pip locks to after you pass your step goal. Defaults to a dark green."
      }
    ]
  },
