[
  {
    "type": "heading",
    "defaultValue": "Simple Pixel Style"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Color Customization"
      },
      {
        "type": "toggle",
        "messageKey": "LIGHT_MODE",
        "label": "Light mode",
        "defaultValue": false,
        "description": "Uses a white background with black text and icons."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_TOP_BAR",
        "label": "Invert top bar",
        "defaultValue": false,
        "description": "Swaps the battery, step, and Bluetooth bar colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_DATE_BAR",
        "label": "Invert date bar",
        "defaultValue": false,
        "description": "Swaps the date bar colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_TIME",
        "label": "Invert time",
        "defaultValue": false,
        "description": "Swaps the time row colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_WEATHER",
        "label": "Invert weather",
        "defaultValue": false,
        "description": "Swaps the complication or verbose weather colors."
      },
      {
        "type": "toggle",
        "messageKey": "INVERT_MEETING_BAR",
        "label": "Invert meeting bar",
        "defaultValue": false,
        "description": "Swaps the meeting bar colors."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Layout"
      },
      {
        "type": "toggle",
        "messageKey": "TOP_STEPS",
        "label": "Top W800 step counter",
        "defaultValue": true,
        "description": "Shows the walking-man step counter above the date."
      },
      {
        "type": "toggle",
        "messageKey": "VERBOSE_WEATHER",
        "label": "Verbose weather, centered time",
        "defaultValue": false,
        "description": "Replaces the complication circles with one centered weather line."
      },
      {
        "type": "select",
        "messageKey": "VERBOSE_WEATHER_STYLE",
        "label": "Verbose weather style",
        "defaultValue": "one_line",
        "options": [
          {
            "label": "One-line",
            "value": "one_line"
          },
          {
            "label": "Large",
            "value": "large"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "COMPLICATION_1",
        "label": "Left circle",
        "defaultValue": "weather",
        "options": [
          { "label": "Temperature", "value": "temperature" },
          { "label": "Weather", "value": "weather" },
          { "label": "Weather icon", "value": "weather_icon" },
          { "label": "Rain chance", "value": "rain" },
          { "label": "Heart rate", "value": "heart_rate" },
          { "label": "Steps", "value": "steps" },
          { "label": "Watch battery", "value": "watch_battery" },
          { "label": "Phone battery", "value": "phone_battery" },
          { "label": "Feels like", "value": "feels_like" },
          { "label": "High temp", "value": "high_temp" },
          { "label": "Wind", "value": "wind" },
          { "label": "UV index", "value": "uv" },
          { "label": "Next event", "value": "next_event" }
        ]
      },
      {
        "type": "select",
        "messageKey": "COMPLICATION_2",
        "label": "Middle circle",
        "defaultValue": "rain",
        "options": [
          { "label": "Temperature", "value": "temperature" },
          { "label": "Weather", "value": "weather" },
          { "label": "Weather icon", "value": "weather_icon" },
          { "label": "Rain chance", "value": "rain" },
          { "label": "Heart rate", "value": "heart_rate" },
          { "label": "Steps", "value": "steps" },
          { "label": "Watch battery", "value": "watch_battery" },
          { "label": "Phone battery", "value": "phone_battery" },
          { "label": "Feels like", "value": "feels_like" },
          { "label": "High temp", "value": "high_temp" },
          { "label": "Wind", "value": "wind" },
          { "label": "UV index", "value": "uv" },
          { "label": "Next event", "value": "next_event" }
        ]
      },
      {
        "type": "select",
        "messageKey": "COMPLICATION_3",
        "label": "Right circle",
        "defaultValue": "heart_rate",
        "options": [
          { "label": "Temperature", "value": "temperature" },
          { "label": "Weather", "value": "weather" },
          { "label": "Weather icon", "value": "weather_icon" },
          { "label": "Rain chance", "value": "rain" },
          { "label": "Heart rate", "value": "heart_rate" },
          { "label": "Steps", "value": "steps" },
          { "label": "Watch battery", "value": "watch_battery" },
          { "label": "Phone battery", "value": "phone_battery" },
          { "label": "Feels like", "value": "feels_like" },
          { "label": "High temp", "value": "high_temp" },
          { "label": "Wind", "value": "wind" },
          { "label": "UV index", "value": "uv" },
          { "label": "Next event", "value": "next_event" }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Weather"
      },
      {
        "type": "toggle",
        "messageKey": "WEATHER_ENABLED",
        "label": "Enable weather",
        "defaultValue": true,
        "description": "Fetches Open-Meteo weather from the phone and updates the weather/rain circles."
      },
      {
        "type": "select",
        "messageKey": "WEATHER_SOURCE",
        "label": "Location",
        "defaultValue": "gps",
        "options": [
          {
            "label": "Current phone location",
            "value": "gps"
          },
          {
            "label": "Manual coordinates",
            "value": "manual"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LAT",
        "label": "Manual latitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "30.246"
        }
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LON",
        "label": "Manual longitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "-87.700"
        }
      },
      {
        "type": "select",
        "messageKey": "TEMPERATURE_UNIT",
        "label": "Temperature unit",
        "defaultValue": "fahrenheit",
        "options": [
          {
            "label": "Fahrenheit",
            "value": "fahrenheit"
          },
          {
            "label": "Celsius",
            "value": "celsius"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "WEATHER_REFRESH_MIN",
        "label": "Refresh",
        "defaultValue": "30",
        "options": [
          {
            "label": "Every 15 minutes",
            "value": "15"
          },
          {
            "label": "Every 30 minutes",
            "value": "30"
          },
          {
            "label": "Every hour",
            "value": "60"
          }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Calendar"
      },
      {
        "type": "toggle",
        "messageKey": "CALENDAR_ENABLED",
        "label": "Enable bottom event",
        "defaultValue": false,
        "description": "Uses a private iCal/ICS feed URL. PebbleKit JS cannot read the phone calendar directly."
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL",
        "label": "Calendar .ics URL",
        "defaultValue": "",
        "attributes": {
          "type": "url",
          "placeholder": "https://calendar.google.com/..."
        }
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL_2",
        "label": "Second calendar .ics URL",
        "defaultValue": "",
        "attributes": {
          "type": "url",
          "placeholder": "https://calendar.google.com/..."
        }
      },
      {
        "type": "select",
        "messageKey": "CALENDAR_LOOKAHEAD_HOURS",
        "label": "Look ahead",
        "defaultValue": "48",
        "options": [
          {
            "label": "24 hours",
            "value": "24"
          },
          {
            "label": "48 hours",
            "value": "48"
          },
          {
            "label": "7 days",
            "value": "168"
          }
        ]
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Fitness Rings"
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_SHAKE_ENABLED",
        "label": "Enable shake to show fitness rings",
        "defaultValue": false
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_RING_STEPS_ON",
        "label": "Show steps ring",
        "defaultValue": true
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_RING_ACTIVE_ON",
        "label": "Show active time ring",
        "defaultValue": true
      },
      {
        "type": "toggle",
        "messageKey": "FITNESS_RING_CALORIES_ON",
        "label": "Show active calories ring",
        "defaultValue": true
      },
      {
        "type": "input",
        "messageKey": "FITNESS_TARGET_STEPS",
        "label": "Steps target",
        "defaultValue": "10000",
        "attributes": {
          "type": "number",
          "min": "1",
          "step": "1"
        }
      },
      {
        "type": "input",
        "messageKey": "FITNESS_TARGET_ACTIVE_MIN",
        "label": "Active minutes target",
        "defaultValue": "30",
        "attributes": {
          "type": "number",
          "min": "1",
          "step": "1"
        }
      },
      {
        "type": "input",
        "messageKey": "FITNESS_TARGET_CALORIES",
        "label": "Active calories target",
        "defaultValue": "500",
        "attributes": {
          "type": "number",
          "min": "1",
          "step": "1"
        }
      },
      {
        "type": "color",
        "messageKey": "FITNESS_COLOR_STEPS",
        "label": "Steps ring color",
        "defaultValue": 65280
      },
      {
        "type": "color",
        "messageKey": "FITNESS_COLOR_ACTIVE",
        "label": "Active ring color",
        "defaultValue": 43775
      },
      {
        "type": "color",
        "messageKey": "FITNESS_COLOR_CALORIES",
        "label": "Calories ring color",
        "defaultValue": 16711680
      }
    ]
  },
  {
    "type": "submit",
    "defaultValue": "Save"
  }
]
