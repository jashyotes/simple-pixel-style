        ]
      },
      {
        "type": "select",
        "messageKey": "MULTI_TZ_STYLE",
        "id": "multi-tz-style",
        "label": "Display style",
        "defaultValue": "text",
        "options": [
          { "label": "Text line", "value": "text" },
          { "label": "Circle complications", "value": "circle" }
        ],
        "description": "Text line shows ABBR:time joined by a divider. Circle complications show each zone as a small dial in the complication row. Times follow the Military time setting in the Time section."
      }
