  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Weather"
      },
      {
        "type": "text",
        "id": "weather-status",
        "defaultValue": ""
      },
      {
        "type": "toggle",
        "messageKey": "WEATHER_ENABLED",
        "label": "Enable weather",
        "defaultValue": true,
        "description": "Fetches Open-Meteo weather from the phone and updates the weather/rain circles."
      },
      {
        "type": "select",
        "messageKey": "WEATHER_SOURCE",
        "label": "Location",
        "defaultValue": "gps",
        "options": [
          {
            "label": "Current phone location",
            "value": "gps"
          },
          {
            "label": "Manual coordinates",
            "value": "manual"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LAT",
        "label": "Manual latitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "30.246"
        }
      },
      {
        "type": "input",
        "messageKey": "WEATHER_LON",
        "label": "Manual longitude",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "placeholder": "-87.700"
        }
      },
      {
        "type": "select",
        "messageKey": "TEMPERATURE_UNIT",
        "label": "Temperature unit",
        "defaultValue": "fahrenheit",
        "options": [
          {
            "label": "Fahrenheit",
            "value": "fahrenheit"
          },
          {
            "label": "Celsius",
            "value": "celsius"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "WEATHER_REFRESH_MIN",
        "label": "Refresh",
        "defaultValue": "30",
        "options": [
          {
            "label": "Every 15 minutes",
            "value": "15"
          },
          {
            "label": "Every 30 minutes",
            "value": "30"
          },
          {
            "label": "Every hour",
            "value": "60"
          }
        ]
      },
      {
        "type": "select",
        "messageKey": "WEATHER_PROVIDER",
        "label": "Forecast provider",
        "defaultValue": "open_meteo",
        "description": "Open-Meteo works worldwide. NWS (api.weather.gov) covers the United States only. When set to NWS, the watch follows NWS for temperature, summary, icon, rain chance, high/low, wind, and the Detailed Weather graph, and the NWS Forecast shake overlay pulls its hourly + narrative data. Feels like, UV index, and sunrise/sunset always come from Open-Meteo.",
        "options": [
          {
            "label": "Open-Meteo only (global, default)",
            "value": "open_meteo"
          },
          {
            "label": "NWS (api.weather.gov, US only)",
            "value": "nws"
          }
        ]
      },
      {
        "type": "input",
        "messageKey": "NWS_ZIP",
        "label": "NWS location ZIP",
        "defaultValue": "",
        "attributes": {
          "type": "text",
          "maxLength": 5,
          "placeholder": "36542"
        },
        "description": "Optional. US ZIP code for the NWS gridpoint lookup (e.g. 36542 = Gulf Shores, AL). Leave blank to use phone GPS or the manual coordinates above. Phone GPS often lands one NWS grid square off; entering a ZIP locks the forecast to that area."
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Calendar"
      },
      {
        "type": "toggle",
        "messageKey": "CALENDAR_ENABLED",
        "label": "Enable bottom event",
        "defaultValue": false,
        "description": "Uses a private iCal/ICS feed URL. PebbleKit JS cannot read the phone calendar directly."
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL",
        "label": "Calendar .ics URL",
        "defaultValue": "",
        "attributes": {
          "type": "url",
          "placeholder": "https://calendar.google.com/..."
        }
      },
      {
        "type": "input",
        "messageKey": "CALENDAR_ICS_URL_2",
        "label": "Second calendar .ics URL",
        "defaultValue": "",
